  "contentVersion": 2,
  "comment": "Input list for scripts/aggregate.mjs. Every fetcher is fail-soft: a dead feed logs a warning and contributes nothing. Add a feed by appending to `rss`; the aggregator needs no code change. Every URL here was probed and returns parseable entries — re-probe before adding one.",
  "notes": {
    "no-rss": "Anthropic, Meta AI, Nous Research, vLLM and DeepLearning.AI publish no working public RSS feed (all 404 as of 2026-07-28). Their releases reach us via Hacker News, AI News (smol.ai), Import AI, and Latent Space instead. Don't re-add those feeds without probing first.",
    "403-from-corp-network": "huggingface.co and reddit.com return 403 behind a corporate TLS-inspecting proxy (Zscaler), so local dry runs show them empty. They work from GitHub Actions runners. Not a bug — don't 'fix' by disabling them."
  },
  "keywords": [
    "LLM", "language model", "open weights", "open-weight", "agentic", "AI agent",
    "agent orchestration", "multi-agent", "agent army", "tool calling", "MCP",
    "Hermes", "openclaw", "Claude", "GPT", "Gemini", "Llama", "Qwen", "DeepSeek",
    "Mistral", "Kimi", "GLM", "inference", "fine-tune", "RAG", "context window",
    "eval", "benchmark", "distillation", "quantization", "self-host"
  ],
